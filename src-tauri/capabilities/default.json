{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, webview zoom (ui scale) plus native open/save dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:webview:allow-set-webview-zoom",
    "dialog:default"
  ]
}
